{
  "$description": "St. Mary's Center Senior Housing Services Training. Import with Tokens Studio, or create these as Figma Variables by hand (collection: SMC).",
  "color": {
    "brand": {
      "navy":        { "$type": "color", "$value": "#06304F", "$description": "Header bars, footer, dark bands, headings" },
      "blue":        { "$type": "color", "$value": "#1C5C7A", "$description": "Primary buttons, links, decision bands" },
      "orange":      { "$type": "color", "$value": "#F4941C", "$description": "Accent only: main call to action, section eyebrows, progress fill, single rules" },
      "orange-deep": { "$type": "color", "$value": "#8A4E08", "$description": "Orange text on light backgrounds (passes contrast)" }
    },
    "ink": {
      "primary":   { "$type": "color", "$value": "#22333F", "$description": "Body text" },
      "secondary": { "$type": "color", "$value": "#3C4A55", "$description": "Paragraphs on white" },
      "muted":     { "$type": "color", "$value": "#5A6873", "$description": "Captions, meta, role titles" },
      "faint":     { "$type": "color", "$value": "#6C7A85", "$description": "Small labels" },
      "on-dark":   { "$type": "color", "$value": "#FFFFFF" },
      "on-dark-muted": { "$type": "color", "$value": "#CFE2EE" }
    },
    "surface": {
      "page":     { "$type": "color", "$value": "#FFFFFF" },
      "canvas":   { "$type": "color", "$value": "#F2F7FA", "$description": "Soft section backgrounds, image wells" },
      "tint":     { "$type": "color", "$value": "#E7F3FB", "$description": "Number badges, image placeholders" },
      "cream":    { "$type": "color", "$value": "#FBF6EF", "$description": "Decision prompt box, saved notice" },
      "mint":     { "$type": "color", "$value": "#E8F3EF", "$description": "Care plan panel, the St. Mary's way column" }
    },
    "border": {
      "default": { "$type": "color", "$value": "#DCE7EE" },
      "subtle":  { "$type": "color", "$value": "#E7EEF3" },
      "input":   { "$type": "color", "$value": "#C9D6DF" },
      "cream":   { "$type": "color", "$value": "#EEDFC7" },
      "mint":    { "$type": "color", "$value": "#BFE0D2" }
    },
    "status": {
      "success":    { "$type": "color", "$value": "#1E6B43" },
      "success-bg": { "$type": "color", "$value": "#E8F6EF" },
      "error":      { "$type": "color", "$value": "#B23A22" },
      "error-bg":   { "$type": "color", "$value": "#FBE6E0" },
      "done":       { "$type": "color", "$value": "#2E7D50" }
    }
  },
  "font": {
    "family": { "$type": "fontFamily", "$value": "Jost", "$description": "Google Fonts. Fallback: Century Gothic, Segoe UI, sans-serif" },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700 }
    }
  },
  "typography": {
    "display":  { "$type": "typography", "$value": { "fontFamily": "Jost", "fontWeight": 600, "fontSize": "46px", "lineHeight": 1.12 } },
    "h1":       { "$type": "typography", "$value": { "fontFamily": "Jost", "fontWeight": 600, "fontSize": "38px", "lineHeight": 1.15 } },
    "h2":       { "$type": "typography", "$value": { "fontFamily": "Jost", "fontWeight": 600, "fontSize": "34px", "lineHeight": 1.2 } },
    "h3":       { "$type": "typography", "$value": { "fontFamily": "Jost", "fontWeight": 600, "fontSize": "26px", "lineHeight": 1.25 } },
    "body-lg":  { "$type": "typography", "$value": { "fontFamily": "Jost", "fontWeight": 400, "fontSize": "18px", "lineHeight": 1.65 } },
    "body":     { "$type": "typography", "$value": { "fontFamily": "Jost", "fontWeight": 400, "fontSize": "17px", "lineHeight": 1.6 } },
    "body-sm":  { "$type": "typography", "$value": { "fontFamily": "Jost", "fontWeight": 400, "fontSize": "15px", "lineHeight": 1.55 } },
    "caption":  { "$type": "typography", "$value": { "fontFamily": "Jost", "fontWeight": 400, "fontSize": "14px", "lineHeight": 1.5 } },
    "eyebrow":  { "$type": "typography", "$value": { "fontFamily": "Jost", "fontWeight": 600, "fontSize": "13px", "lineHeight": 1.4, "letterSpacing": "0.2em", "textCase": "uppercase" } },
    "button":   { "$type": "typography", "$value": { "fontFamily": "Jost", "fontWeight": 600, "fontSize": "16px", "lineHeight": 1.2 } }
  },
  "radius": {
    "sm":   { "$type": "dimension", "$value": "10px", "$description": "Buttons, inputs" },
    "md":   { "$type": "dimension", "$value": "14px", "$description": "Small cards, portraits, step rows" },
    "lg":   { "$type": "dimension", "$value": "18px", "$description": "Large cards, covers, panels" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "24px" },
    "6": { "$type": "dimension", "$value": "32px" },
    "7": { "$type": "dimension", "$value": "48px" },
    "8": { "$type": "dimension", "$value": "64px" },
    "9": { "$type": "dimension", "$value": "72px" }
  },
  "layout": {
    "content-max":  { "$type": "dimension", "$value": "1180px", "$description": "Training Home" },
    "academy-max":  { "$type": "dimension", "$value": "992px",  "$description": "Academy pages (62em)" },
    "reading-max":  { "$type": "dimension", "$value": "832px",  "$description": "Course player and exam (52em)" },
    "gutter":       { "$type": "dimension", "$value": "32px" }
  },
  "shadow": {
    "card":  { "$type": "shadow", "$value": { "x": 0, "y": 10, "blur": 26, "spread": 0, "color": "rgba(6,48,79,0.06)" } },
    "raise": { "$type": "shadow", "$value": { "x": 0, "y": 16, "blur": 40, "spread": 0, "color": "rgba(6,48,79,0.10)" } },
    "cta":   { "$type": "shadow", "$value": { "x": 0, "y": 12, "blur": 26, "spread": 0, "color": "rgba(244,148,28,0.32)" } }
  }
}
